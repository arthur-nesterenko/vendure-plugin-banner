{
    "name": "vendure-banner-plugin",
    "version": "2.0.0",
    "description": "A plugin for the Vendure e-commerce framework designed to enhance the visual appeal and interactivity of your e-commerce site by allowing for the creation of dynamic banners that can be added to any page.",
    "author": "Arthur Nestererenko <arthur.nesterenko.dev@gmail.com>",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/arthur-nesterenko/vendure-plugin-banner.git"
    },
    "license": "MIT",
    "private": false,
    "engines": {
        "node": ">=22.0.0"
    },
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "files": [
        "dist",
        "README.md"
    ],
    "scripts": {
        "run:server": "ts-node ./dev-server/index.ts",
        "run:worker": "ts-node ./dev-server/index-worker.ts",
        "watch": "ts-node-dev  ./dev-server/index.ts",
        "start": "concurrently npm:run:*",
        "build": "rimraf dist && npm run codegen && tsc -p ./tsconfig.build.json && npm run copy-assets",
        "copy-assets": "ts-node scripts/copy-assets.ts",
        "codegen": "ts-node codegen.ts",
        "prepare": "husky",
        "lint": "eslint .",
        "prettify": "prettier --write . --html-whitespace-sensitivity ignore",
        "lint:fix": "npm run lint --fix",
        "commit": "git-cz",
        "e2e": "vitest run --project e2e",
        "e2e:watch": "vitest --project e2e --watch",
        "test:unit": "vitest run --project unit",
        "test:unit:watch": "vitest --project unit --watch",
        "test": "vitest run",
        "tsc": "tsc --noEmit",
        "i18n:extract": "lingui extract"
    },
    "devDependencies": {
        "@testing-library/jest-dom": "^6.6.3",
        "@testing-library/react": "^16.0.1",
        "@testing-library/user-event": "^14.5.2",
        "@commitlint/cli": "^19.7.1",
        "@commitlint/config-conventional": "^19.7.1",
        "@commitlint/cz-commitlint": "^19.6.1",
        "@eslint/js": "^9.21.0",
        "@graphql-codegen/cli": "^5.0.7",
        "@graphql-codegen/typescript": "^4.1.6",
        "@graphql-codegen/typescript-document-nodes": "^4.0.16",
        "@graphql-codegen/typescript-operations": "^4.6.1",
        "@lingui/cli": "^5.7.0",
        "@lingui/format-po": "^5.7.0",
        "@swc/core": "^1.11.31",
        "@types/eslint__js": "^8.42.3",
        "@types/fs-extra": "^11.0.4",
        "@types/node": "^22.15.30",
        "@vendure/asset-server-plugin": "3.5.5",
        "@vendure/core": "3.5.5",
        "@vendure/graphiql-plugin": "3.5.5",
        "@vendure/testing": "3.5.5",
        "better-sqlite3": "^11.10.0",
        "commitizen": "^4.3.1",
        "concurrently": "^9.1.2",
        "copyfiles": "^2.4.1",
        "dotenv": "^16.5.0",
        "eslint": "^9.21.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-import": "^2.31.0",
        "eslint-plugin-prettier": "^5.2.3",
        "fs-extra": "^11.3.0",
        "graphql-tag": "^2.12.6",
        "husky": "^9.1.7",
        "inquirer": "9",
        "prettier": "^3.5.3",
        "rimraf": "^6.0.1",
        "ts-node": "10.9.2",
        "ts-node-dev": "^2.0.0",
        "typescript": "5.8.3",
        "typescript-eslint": "^8.25.0",
        "unplugin-swc": "^1.5.4",
        "vitest": "^3.2.3",
        "jsdom": "^25.0.1",
        "react": "^19.2.4",
        "react-dom": "^19.2.4",
        "@lingui/core": "^5.7.0",
        "@lingui/react": "^5.7.0",
        "@vendure/dashboard": "^3.5.5"
    }
}
